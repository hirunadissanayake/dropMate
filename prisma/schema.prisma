generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  TRAVELER
  ADMIN
}


enum ParcelStatus {
  PENDING
  MATCHED
  PICKED_UP
  IN_TRANSIT
  ARRIVED
  DELIVERED
  CANCELLED
}

enum TripStatus {
  ACTIVE
  DEACTIVATED
  COMPLETED
  CANCELLED
}

enum MatchStatus {
  PENDING
  ACCEPTED
  REJECTED
  COMPLETED
}

enum OtpType {
  LOGIN
  REGISTRATION
  PICKUP
  DELIVERY
  PASSWORD_RESET
}

enum DeliveryMethod {
  DIRECT
  PICKUP_POINT
  DOOR_DELIVERY
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
  FAILED
}

enum PaymentMethod {
  ONLINE
  CASH_ON_PICKUP
  CASH_ON_DELIVERY
}

enum NotificationType {
  PROFILE_APPROVED
  PROFILE_REJECTED
  PARCEL_CREATED
  PARCEL_REQUEST
  DELIVERY_REQUEST
  PARCEL_ACCEPTED
  PARCEL_REJECTED
  MATCH_EXPIRED
  PARCEL_PICKED_UP
  PARCEL_DELIVERED
  PAYMENT_RECEIVED
  WITHDRAWAL_APPROVED
  WITHDRAWAL_REJECTED
  GENERAL
}

model User {
  id              String      @id @default(cuid())
  name            String
  phone           String      @unique
  email           String?     @unique
  password        String?
  selfieUrl       String?
  nicFrontUrl     String?
  nicBackUrl      String?
  nicNumber       String?     @unique
  permanentAddress String?
  fcmToken          String?
  city             String?
    
  // Traveler specific
  termsAccepted   Boolean     @default(false)

  // ✅ NEW ROLE SYSTEM
  isCustomerRequested  Boolean @default(false)
  isTravelerRequested  Boolean @default(false)

  isCustomerApproved   Boolean @default(false)
  isTravelerApproved   Boolean @default(false)

  roleActive           UserRole?

  travelerRating  Float       @default(0)
  customerRating  Float       @default(0)
  walletBalance   Float       @default(0)  // Traveler's pending payout balance in LKR

  rejectionReason String?
  isBlocked       Boolean     @default(false)
  blockReason     String?

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  parcels              Parcel[]             @relation("UserParcels")
  trips                Trip[]               @relation("UserTrips")
  otps                 Otp[]
  sentMatches          Match[]              @relation("SenderMatches")
  travelerMatches      Match[]              @relation("TravelerMatches")
  walletTransactions   WalletTransaction[]  @relation("UserWalletTransactions")
  bankDetails          BankDetail[]
  notifications        Notification[]       @relation("UserNotifications")
  topUpRequests        TopUpRequest[]

  sentReviews          Review[]             @relation("Reviewer")
  receivedReviews      Review[]             @relation("Reviewee")
}

model Parcel {
  id              String        @id @default(cuid())
  senderId        String
  sender          User          @relation("UserParcels", fields: [senderId], references: [id])

  name            String?
  fromLocation    String
  toLocation      String
  weight          Float
  description     String?
  imageUrls       String[]

  // ✅ NEW RECEIVER SYSTEM
  receiverName    String
  receiverPhone   String
  deliveryMethod  DeliveryMethod @default(DIRECT)
  deliveryAddress String?       // optional for door delivery
  note            String?       // optional instructions

  status          ParcelStatus  @default(PENDING)

  // Pricing fields
  price           Float?        // Total customer pays
  platformFee     Float?        // DropMate's cut
  travelerPayout  Float?        // What traveler earns
  
  paymentStatus   PaymentStatus @default(PENDING)
  paymentMethod   PaymentMethod @default(ONLINE)
  
  routeId         String?       // Link to which route was used
  route           Route?        @relation(fields: [routeId], references: [id])

  matchedTripId   String?
  matchedTrip     Trip?         @relation(fields: [matchedTripId], references: [id])

  matchedMatchId  String?       @unique
  matchedMatch    Match?        @relation("MatchedParcel", fields: [matchedMatchId], references: [id])

  walletTransactions WalletTransaction[]

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  matches         Match[]
  reviews         Review[]
}

model Trip {
  id            String      @id @default(cuid())
  travelerId    String
  traveler      User        @relation("UserTrips", fields: [travelerId], references: [id])

  fromLocation  String
  toLocation    String
  travelDate    DateTime

  capacityKg    Float
  usedCapacity  Float       @default(0)
  travelTime    String?
  note          String?
  exactLocation String?
  vehicleType   String?
  pickupUrl     String?
  dropoffUrl    String?

  status        TripStatus  @default(ACTIVE)

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  parcels       Parcel[]
  matches       Match[]
}

model Match {
  id            String       @id @default(cuid())

  parcelId      String
  parcel        Parcel       @relation(fields: [parcelId], references: [id])

  tripId        String
  trip          Trip         @relation(fields: [tripId], references: [id])

  matchedParcel Parcel?      @relation("MatchedParcel")

  senderId      String
  travelerId    String

  sender        User         @relation("SenderMatches", fields: [senderId], references: [id])
  traveler      User         @relation("TravelerMatches", fields: [travelerId], references: [id])

  score         Float

  status        MatchStatus  @default(PENDING)

  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model Otp {
  id          String     @id @default(cuid())
  
  userId      String?
  user        User?      @relation(fields: [userId], references: [id])

  phone       String?

  code        String
  type        OtpType

  pendingData Json?

  expiresAt   DateTime
  createdAt   DateTime   @default(now())
}

model AdminAction {
  id          String   @id @default(cuid())
  adminId     String
  action      String
  targetId    String
  createdAt   DateTime @default(now())
}

model Route {
  id            String   @id @default(cuid())
  fromLocation  String                        // e.g., "Pettah"
  toLocation    String                        // e.g., "Jaffna"
  distanceKm    Float                         // e.g., 400
  rate          Float                         // e.g., 1000 (LKR)
  isActive      Boolean  @default(true)       // Admin can disable routes
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  parcels       Parcel[]

  @@unique([fromLocation, toLocation])        // No duplicate routes
}

model WeightSlab {
  id            String   @id @default(cuid())
  minWeight     Float                         // e.g., 0
  maxWeight     Float                         // e.g., 1
  surcharge     Float                         // e.g., 0 (LKR)
  label         String?                       // e.g., "Light (0-1 kg)"
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model PlatformConfig {
  id               String   @id @default(cuid())
  key              String   @unique           // e.g., "platformFeePercent"
  value            String                     // e.g., "15"
  description      String?                    // e.g., "Platform fee percentage"
  updatedAt        DateTime @updatedAt
}

enum WalletTransactionType {
  DELIVERY_EARNED         // Credited when a parcel is delivered
  WITHDRAWAL              // Debited when traveler withdraws to bank
  PLATFORM_FEE_DEDUCTION  // Debited when traveler collects cash and platform takes its share
}

enum WalletTransactionStatus {
  PENDING    // Withdrawal requested, waiting for admin to process
  COMPLETED  // Funds transferred to bank
  FAILED     // Transfer failed
}

model WalletTransaction {
  id          String                  @id @default(cuid())
  userId      String
  user        User                    @relation("UserWalletTransactions", fields: [userId], references: [id])

  type        WalletTransactionType
  amount      Float                              // LKR amount
  status      WalletTransactionStatus @default(COMPLETED)

  description String?                            // e.g., "Earned from Colombo → Kandy delivery"
  parcelId    String?                            // Link to the parcel (for DELIVERY_EARNED type)
  parcel      Parcel?                 @relation(fields: [parcelId], references: [id])

  createdAt   DateTime                @default(now())
}

model BankDetail {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id])
  
  bankName          String
  accountNumber     String
  accountHolderName String
  branchName        String?
  isDefault         Boolean  @default(false)
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([userId])
}

model Notification {
  id          String           @id @default(cuid())
  userId      String
  user        User             @relation("UserNotifications", fields: [userId], references: [id])

  type        NotificationType
  title       String
  body        String
  isRead      Boolean          @default(false)

  // Optional deep-link metadata
  metadata    Json?            // e.g., { tripId, parcelId }

  createdAt   DateTime         @default(now())

  @@index([userId])
}

model GlobalMessage {
  id          String   @id @default(cuid())
  senderId    String
  senderName  String
  senderRole  String
  message     String
  type        String   @default("CHAT") // CHAT or BROADCAST
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SupportMessage {
  id          String   @id @default(cuid())
  userId      String   // The customer/traveler ID
  isAdmin     Boolean  @default(false) // True if message is from admin to user
  senderName  String?
  message     String
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())
  
  @@index([userId])
}

enum TopUpStatus {
  PENDING
  APPROVED
  REJECTED
}

model TopUpRequest {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id])
  
  amount      Float
  slipUrl     String
  status      TopUpStatus  @default(PENDING)
  adminNote   String?

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([userId])
}

model Banner {
  id          String   @id @default(cuid())
  imageUrl    String
  title       String?
  description String?
  link        String?  // Optional link when clicking banner
  isActive    Boolean  @default(true)
  screen      String   @default("BOTH") // TRAVELER, CUSTOMER, BOTH
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
model DropMateBankDetail {
  id                String   @id @default(cuid())
  bankName          String
  accountName       String
  accountNumber     String
  branchName        String
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

enum ReviewRole {
  CUSTOMER
  TRAVELER
}

model Review {
  id          String   @id @default(uuid())
  rating      Int      @default(0)
  comment     String?
  parcelId    String
  parcel      Parcel   @relation(fields: [parcelId], references: [id])
  reviewerId  String
  reviewer    User     @relation("Reviewer", fields: [reviewerId], references: [id])
  revieweeId  String
  reviewee    User     @relation("Reviewee", fields: [revieweeId], references: [id])
  revieweeRole ReviewRole @default(CUSTOMER)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([parcelId, reviewerId])
}
